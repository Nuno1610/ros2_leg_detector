<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="classic_detector_world">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="target_person">
      <static>true</static>
      <pose>2.2 0.0 0.9 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><cylinder><radius>0.28</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.28</radius><length>1.7</length></cylinder></geometry><material><ambient>0.8 0.3 0.15 1</ambient><diffuse>0.8 0.3 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_left">
      <static>true</static><pose>1.0 1.6 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.0 0.5 1.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.5 1.0</size></box></geometry></visual></link>
    </model>
    <model name="obstacle_right">
      <static>true</static><pose>1.0 -1.6 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.0 0.5 1.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.5 1.0</size></box></geometry></visual></link>
    </model>
  </world>
</sdf>
